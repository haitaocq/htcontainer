# 1、mutica 配置
MULTICA_SERVER_URL=
MULTICA_APP_URL=
MULTICA_TOKEN=

# 2、opencode 第三方大模型配置，OPENCODE_MODEL支持配置多个模型ID,使用都好分隔
OPENCODE_PROVIDER=
OPENCODE_BASE_URL=
OPENCODE_API_TOKEN=
OPENCODE_MODEL=
OPENCODE_MODEL_DEFAULT=

# 3、cc-connect配置
CC_ADMIN_FROM=*  # 项目级的管理员白名单,建议生产环境不要用 "*"（除非是单用户个人环境）；使用平台返回的用户 ID 列表（逗号分隔）
CC_WORK_DIR=${HOME:-/home/agents}/cc-workspace/feishu
CC_MODE=default  #"yolo"  # "default" | "acceptEdits" (edit) | "plan" | "auto" | "bypassPermissions" (yolo)
FEISHU_APP_ID=
FEISHU_APP_SECRET=