# 1、dsh 基础配置
DSH_HOME=/home/agents/.dsh
# 内嵌 Caddy 前置反向代理（默认 true）：dsh 内部绑定 127.0.0.1:DSH_UPSTREAM_PORT，
# Caddy 对外监听 DSH_PORT 并改写 Host/Origin 为 localhost，
# 使远程浏览器也能使用设置/模型页（loopback-only 的特权 RPC）
DSH_CADDY=true
DSH_PORT=3080                # 对外监听端口（Caddy）
DSH_UPSTREAM_PORT=3081       # dsh 内部监听端口（仅 127.0.0.1，不要对外映射）
# 仅 DSH_CADDY=false 直连模式时生效：Web 绑定地址与浏览器信任栅栏
DSH_BIND_HOST=0.0.0.0
DSH_TRUSTED_HOSTS=           # 浏览器访问所用的地址（IP/域名，逗号或空格分隔）
DSH_TOOLS_MODE=code          # 工具沙箱模式：native | code | both（容器内建议 code）
DSH_WORKSPACE=/home/agents/workspace

# 2、LLM 接入（以下两种方式任选其一）

# 2.1 DeepSeek 原生接入：只需设置 API Key
DEEPSEEK_API_KEY=

# 2.2 自定义 OpenAI 兼容 provider：三者都必须设置才会生效
# DSH_MODEL 支持多个模型 ID，使用逗号分隔
# DSH_MODEL_DEFAULT 指定默认模型（未设置时自动取模型列表第一个）
DSH_PROVIDER_ID=custom-provider
DSH_BASE_URL=
DSH_API_TOKEN=
DSH_MODEL=
DSH_MODEL_DEFAULT=
